{
  "name": "StoreShelf - store screenshot studio",
  "short_name": "StoreShelf",
  "description": "Local-first App Store & Google Play screenshot designer. Works offline, uploads nothing.",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b0b12",
  "theme_color": "#2563eb",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
